# Copy to .env.local for local dev. In production set these in the
# Cloudflare Pages dashboard → Settings → Environment variables.

# Public origin used for canonical URLs, sitemap, OG, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tanyonghong.com

# Contact form (Resend). Without RESEND_API_KEY the form fails gracefully
# and tells visitors to reach you on LinkedIn / X.
RESEND_API_KEY=
# Optional overrides:
# CONTACT_TO=tanyonghong.prv@gmail.com
# CONTACT_FROM=Young <hello@yourdomain.com>
